#!/usr/bin/env bash
set -euo pipefail

# x86-64-v2 is required: without SSE4.2/POPCNT, runtimes inside gVisor sandboxes
# can spin instead of failing. x86-64-v3 (AVX2) is needed by Bun-based tools such
# as Claude Code, so its absence is only reported. Uses shell builtins only.
readonly CPUINFO=${THE8020_CPUINFO:-/proc/cpuinfo}
readonly ARCHITECTURE=${THE8020_CPU_ARCHITECTURE:-$(uname -m)}
readonly V2_FLAGS=(cx16 lahf_lm popcnt sse4_1 sse4_2 ssse3)
readonly V3_FLAGS=(avx avx2 bmi1 bmi2 f16c fma abm movbe xsave)

if (( $# > 0 )); then
  echo 'usage: the8020-check-cpu' >&2
  exit 2
fi
case "$ARCHITECTURE" in
  x86_64|amd64) ;;
  *) exit 0 ;;
esac
if [[ ! -r "$CPUINFO" ]]; then
  echo "cannot read $CPUINFO to check the host CPU level" >&2
  exit 1
fi

flags=""
while IFS= read -r line; do
  if [[ "$line" == flags* ]]; then
    flags=" ${line#*:} "
    break
  fi
done < "$CPUINFO"

missing() {
  local flag result=""
  for flag in "$@"; do
    [[ "$flags" == *" $flag "* ]] || result+=" $flag"
  done
  printf '%s' "${result# }"
}

missing_v2=$(missing "${V2_FLAGS[@]}")
missing_v3=$(missing "${V3_FLAGS[@]}")

if [[ ${THE8020_CPU_CHECK:-} == skip ]]; then
  echo "cpu: check skipped by THE8020_CPU_CHECK=skip${missing_v2:+ (missing x86-64-v2: $missing_v2)}" >&2
  exit 0
fi
if [[ -n "$missing_v2" ]]; then
  echo "the host CPU does not provide x86-64-v2 (missing: $missing_v2); 80|20 requires x86-64-v2 or newer, so on KVM/Proxmox set the VM CPU type to host or x86-64-v3" >&2
  exit 1
fi
if [[ -n "$missing_v3" ]]; then
  echo "cpu: x86-64-v3 is unavailable (missing: $missing_v3); Bun-based tools such as Claude Code will not run in development sandboxes" >&2
fi
