{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14",
    "@the8020/http": "./http/mod.ts",
    "@the8020/kernel": "./kernel/mod.ts",
    "@the8020/protocol": "../protocol/generated.ts",
    "/p/": "file:///workspace/packages/",
    "hono": "jsr:@hono/hono@4.9.8",
    "zod": "npm:zod@4.1.5"
  },
  "tasks": {
    "check": "deno fmt --check . ../protocol/generated.ts && deno lint . ../protocol/generated.ts && deno check supervisor/main.ts worker/runtime_worker_test.ts supervisor/supervisor_test.ts http/http_test.ts",
    "test": "deno test --unstable-worker-options --allow-read=.,../protocol --allow-net --allow-import ."
  }
}
