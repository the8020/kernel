ARG DENO_BASE
FROM ${DENO_BASE}

ENV DENO_NO_UPDATE_CHECK=1 \
    DENO_NO_PROMPT=1 \
    DENO_DIR=/runtime-cache

USER root
COPY build/ /tmp/the8020-image-build/
RUN /bin/bash /tmp/the8020-image-build/build.sh && \
    rm -rf /tmp/the8020-image-build

COPY --chown=deno:deno runtime/ /opt/runtime/

RUN /bin/bash /opt/runtime/bundle-runtime.sh /opt/runtime/http-source /opt/runtime/http && \
    rm -rf /opt/runtime/http-source /opt/runtime/bundle-runtime.sh

USER deno
WORKDIR /opt/runtime
EXPOSE 8000 9229
ENTRYPOINT ["deno", "run", "--unstable-worker-options", "--config=/opt/runtime/deno.json", "--cached-only", "--no-prompt", "--inspect=0.0.0.0:9229", "--allow-read=/opt/runtime,/artifacts", "--allow-write=/tmp,/runtime-cache", "--allow-run=/usr/bin/deno", "--allow-net", "--allow-import", "--allow-env=NODE_ID,SANDBOX_ID,WORKLOAD_TYPE,IMAGE_DIGEST,INTERNAL_API_TOKEN,KERNEL_SOCKET_PATH,SUPERVISOR_HOST,SUPERVISOR_PORT,INSPECTOR_PORT,RUNTIME_PROFILE_HASH,HEARTBEAT_INTERVAL_MS,WORKER_STOP_GRACE_MS", "/opt/runtime/supervisor/main.ts"]
