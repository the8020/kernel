# System-wide login profile for interactive development shells.

if [ -n "${BASH_VERSION:-}" ]; then
  case $- in
    *i*)
      if [ -r /etc/bash.bashrc ]; then
        . /etc/bash.bashrc
      fi
      case ${TERM:-dumb} in
        xterm*|rxvt*|screen*|tmux*|linux|vt100)
          PS1='\[\033[1;32m\]\u@\h\[\033[0m\]:\[\033[1;34m\]\w\[\033[0m\]\$ '
          ;;
        *)
          PS1='\u@\h:\w\$ '
          ;;
      esac
      ;;
  esac
fi
