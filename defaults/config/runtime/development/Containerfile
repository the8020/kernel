ARG DENO_BASE=docker.io/denoland/deno:2.9.8@sha256:a0d88a7fcbd44f062cba2748e19df67d30290ad12aa203c7c1e0b12462c483f0
FROM ${DENO_BASE}

USER root
COPY build.sh /tmp/the8020-image-build.sh
RUN /bin/bash /tmp/the8020-image-build.sh \
 && rm -f /tmp/the8020-image-build.sh

COPY files/ /opt/development/
RUN chmod 0555 /opt/development/sandbox.sh \
 && install -m 0444 /opt/development/profile /etc/profile

USER root
ENV HOME=/root DENO_DIR=/root/.cache/deno DENO_NO_UPDATE_CHECK=1 DENO_NO_PROMPT=1
WORKDIR /workspace
ENTRYPOINT ["/bin/bash", "/opt/development/sandbox.sh"]
